global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["127.0.0.1:9090"]

  - job_name: "user-service"
    scheme: https
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: ["${USER_SERVICE_HOST}"]

  - job_name: "product-service"
    scheme: https
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: ["${PRODUCT_SERVICE_HOST}"]

  - job_name: "order-service"
    scheme: https
    metrics_path: /actuator/prometheus
    static_configs:
      - targets: ["${ORDER_SERVICE_HOST}"]
